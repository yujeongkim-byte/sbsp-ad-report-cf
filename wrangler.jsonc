{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbsp-ad-report-cf",
  "compatibility_date": "2026-08-03",
  "main": "src/index.js",
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "UPLOAD_SECRET": "0816"
  },
  "d1_databases": [
    {
      "binding": "REPORT_DB",
      "database_name": "sbsp-report-db",
      "database_id": "814bd7e4-0f87-4aea-8510-400a72bfd24f"
    }
  ]
}
